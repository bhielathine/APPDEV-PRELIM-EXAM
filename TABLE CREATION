CREATE TABLE availability (
    availability_id INT AUTO_INCREMENT PRIMARY KEY,
    status VARCHAR(30) NOT NULL UNIQUE
);
CREATE TABLE account (
    account_id INT AUTO_INCREMENT PRIMARY KEY,
    email_account VARCHAR(255) NOT NULL UNIQUE,
    username VARCHAR(100) NOT NULL,
    password VARCHAR(10) NOT NULL,
    availability_id INT NOT NULL,

    CONSTRAINT fk_account_availability
        FOREIGN KEY (availability_id)
        REFERENCES availability(availability_id)
);
CREATE TABLE game (
    game_id INT AUTO_INCREMENT PRIMARY KEY,
    game_name VARCHAR(100) NOT NULL UNIQUE
);
CREATE TABLE account_game (
    account_id INT NOT NULL,
    game_id INT NOT NULL,
    description VARCHAR(255),

    PRIMARY KEY (account_id, game_id),

    CONSTRAINT fk_account_game_account
        FOREIGN KEY (account_id)
        REFERENCES account(account_id)
        ON DELETE CASCADE,

    CONSTRAINT fk_account_game_game
        FOREIGN KEY (game_id)
        REFERENCES game(game_id)
        ON DELETE CASCADE
);
CREATE TABLE social_media (
    social_media_id INT AUTO_INCREMENT PRIMARY KEY,
    platform_name VARCHAR(50) NOT NULL UNIQUE
);
CREATE TABLE account_social_media (
    account_id INT NOT NULL,
    social_media_id INT NOT NULL,

    PRIMARY KEY (account_id, social_media_id),

    CONSTRAINT fk_account_social_account
        FOREIGN KEY (account_id)
        REFERENCES account(account_id)
        ON DELETE CASCADE,

    CONSTRAINT fk_account_social_platform
        FOREIGN KEY (social_media_id)
        REFERENCES social_media(social_media_id)
        ON DELETE CASCADE
);
